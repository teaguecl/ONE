# cmake -DSOURCE_DIR=dir -DBASE_VERSION=0.1.0 -DOUTPUT=one_version.h -P version.cmake
# Writes one_version.h: ONE_VERSION_STRING, ONE_VERSION_MAJOR / MINOR / PATCH. BASE_VERSION is the project's version
# (CMakeLists.txt, edited at a release). A build of exactly the commit tagged v<BASE_VERSION> from a clean tree says
# "0.1.0"; any other build adds the commit, "0.1.0+g1a2b3c4" (and "-dirty" if the tree has local changes to tracked
# files); without git (a source archive) it says "0.1.0". Run at every build; the header is touched only when its text
# changes, so a new commit recompiles just version.c.
set(version "${BASE_VERSION}")
find_package(Git QUIET)
if(GIT_FOUND AND EXISTS "${SOURCE_DIR}/.git")
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --short=7 HEAD
        OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
    if(rc EQUAL 0 AND commit)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" status --porcelain --untracked-files=no
            OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" tag --points-at HEAD --list "v${BASE_VERSION}"
            OUTPUT_VARIABLE tagged OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(changes)
            set(version "${BASE_VERSION}+g${commit}-dirty")
        elseif(NOT tagged)
            set(version "${BASE_VERSION}+g${commit}")
        endif()
    endif()
endif()
string(REGEX MATCH "^([0-9]+)\\.([0-9]+)\\.([0-9]+)" ignored "${BASE_VERSION}")
file(WRITE "${OUTPUT}.tmp"
    "// generated by cmake/version.cmake: do not edit\n"
    "#define ONE_VERSION_STRING \"${version}\"\n"
    "#define ONE_VERSION_MAJOR ${CMAKE_MATCH_1}\n"
    "#define ONE_VERSION_MINOR ${CMAKE_MATCH_2}\n"
    "#define ONE_VERSION_PATCH ${CMAKE_MATCH_3}\n")
configure_file("${OUTPUT}.tmp" "${OUTPUT}" COPYONLY)   # (touches it only when it changed)
file(REMOVE "${OUTPUT}.tmp")
